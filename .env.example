# ---- Supabase (client-safe) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (server only) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Edge function secret (set with: supabase secrets set) ----
GEMINI_API_KEY=your-gemini-api-key

# Leave the NEXT_PUBLIC_ vars unset to run in offline demo mode with mock data.

# ---- Stable anonymous tags (server only) ----
# Any long random string. Changing it re-rolls everyone's anon tag, so set once.
ANON_TAG_SECRET=change-me-to-a-long-random-string

# ---- Moderation dashboard (server only) ----
# Comma-separated emails allowed to open /mod and take moderation actions.
ADMIN_EMAILS=you@example.com
